{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "vendor/sshfighter/src/**/*.d.ts",
    "vendor/sshfighter-sf8/src/**/*.d.ts"
  ]
}
