[Unit]
Description=SSH Fighter standing bot - BLANK-BOT / BLANKO oscillator
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/Dev/.sshfighter/blank_bot_ed25519

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h/Dev/sshfighter-agent-roster
ExecStart=/usr/bin/pnpm runner:blank-standing --identity %h/Dev/.sshfighter/blank_bot_ed25519 --out-dir %h/Dev/.sshfighter/logs/blank-bot --seed 20260822 --armed
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
